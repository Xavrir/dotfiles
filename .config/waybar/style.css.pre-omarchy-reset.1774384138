@define-color surface           #1e1e2e;
@define-color on_surface        #cdd6f4;
@define-color primary           #cba6f7;
@define-color secondary         #a6e3a1;
@define-color tertiary          #f9e2af;
@define-color on_primary        #11111b;
@define-color surface_container #313244;
@define-color outline           #585b70;
@define-color error             #f38ba8;

* {
    font-family: 'FiraCode Nerd Font Mono', sans-serif;
    font-size: 14px;
    font-weight: 800;
    border: none;
    border-radius: 0;
    outline: none;
    box-shadow: none;
    text-shadow: none;
}

window#waybar {
    background-color: transparent;
    color: @on_surface;
    border: none;
}

.modules-center {
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 20px;
    padding: 0 16px;
}

#clock {
    color: @on_surface;
    font-size: 15px;
    font-weight: 900;
    padding-left: 8px;
    padding-right: 8px;
}

#custom-spotify {
    color: @secondary;
    padding-left: 8px;
    padding-right: 12px;
}

#custom-spotify.inactive {
    opacity: 0;
    min-width: 0;
    padding: 0;
    margin: 0;
}

#workspaces {
    padding: 0;
    margin: 0;
}

#workspaces button {
    color: alpha(@outline, 0.5);
    background-color: transparent;
    margin: 5px 2px;
    padding: 0 8px;
    min-width: 16px;
    border-radius: 16px;
    transition: all 0.3s cubic-bezier(.55, -0.68, .48, 1.68);
}

#workspaces button:hover {
    color: @on_surface;
    background-color: alpha(@outline, 0.1);
}

#workspaces button.active {
    color: #000000;
    background-color: rgba(205, 214, 244, 0.85);
    min-width: 30px;
    padding: 0 12px;
}

#custom-apps {
    color: @primary;
    font-size: 16px;
    padding: 0 8px;
    min-width: 16px;
}

#custom-btop {
    color: @primary;
    padding: 0 8px;
    font-size: 15px;
    min-width: 16px;
}

#custom-volume {
    color: @tertiary;
    padding: 0 8px;
    font-size: 15px;
}

#bluetooth {
    color: #d3869b;
    padding: 0 8px;
    font-size: 15px;
}

#bluetooth.off,
#bluetooth.disabled,
#bluetooth.no-controller {
    opacity: 0.4;
}

#network {
    color: @secondary;
    padding: 0 8px;
    font-size: 15px;
}

#custom-battery {
    color: @secondary;
    padding: 0 8px;
    font-size: 15px;
}

#custom-battery.warning {
    color: @error;
}

#custom-battery.critical {
    color: @error;
}

tooltip {
    background: alpha(@surface, 0.95);
    border-radius: 12px;
    border: 1px solid alpha(@outline, 0.2);
}

tooltip label {
    color: @on_surface;
}

#custom-voxtype {
    min-width: 12px;
    margin: 0 0 0 7.5px;
}

#custom-voxtype.recording {
    color: @error;
}

#custom-idle-indicator.active,
#custom-notification-silencing-indicator.active {
  color: #a55555;
}
