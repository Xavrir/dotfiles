{
  "layer": "top",
  "position": "top",
  "margin-top": 10,
  "height": 40,
  "spacing": 0,
  "fixed-center": true,
  "reload_style_on_change": true,
  "modules-left": [],
  "modules-center": [
    "clock",
    "hyprland/workspaces",
    "custom/spotify",
    "custom/apps",
    "custom/btop",
    "custom/volume",
    "bluetooth",
    "network",
    "custom/battery",
    "custom/screensaver"
  ],
  "modules-right": [],
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %b %d}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "custom/spotify": {
    "format": "{}",
    "return-type": "json",
    "exec": "python3 -c 'import json, subprocess\n\ndef run(args):\n    return subprocess.check_output(args, text=True).strip()\n\ntry:\n    status = run([\"playerctl\", \"-p\", \"spotify\", \"status\"])\nexcept Exception:\n    print(json.dumps({\"text\": \"\", \"class\": \"inactive\"}))\n    raise SystemExit(0)\n\nif status == \"Playing\":\n    title = run([\"playerctl\", \"-p\", \"spotify\", \"metadata\", \"--format\", \"{{title}}\"])\n    artist = run([\"playerctl\", \"-p\", \"spotify\", \"metadata\", \"--format\", \"{{artist}}\"])\n\n    if title and artist:\n        text = f\"\\u266b {title} \\u2022 {artist}\"\n        tooltip = text\n    elif title:\n        text = f\"\\u266b {title}\"\n        tooltip = title\n    else:\n        text = \"\\u266b\"\n        tooltip = \"Spotify\"\n\n    print(json.dumps({\"text\": text, \"class\": \"active playing\", \"tooltip\": tooltip}))\nelif status == \"Paused\":\n    title = run([\"playerctl\", \"-p\", \"spotify\", \"metadata\", \"--format\", \"{{title}}\"])\n    artist = run([\"playerctl\", \"-p\", \"spotify\", \"metadata\", \"--format\", \"{{artist}}\"])\n\n    if title and artist:\n        text = f\"\\u23f8 {title} \\u2022 {artist}\"\n        tooltip = text\n    elif title:\n        text = f\"\\u23f8 {title}\"\n        tooltip = title\n    else:\n        text = \"\\u23f8\"\n        tooltip = \"Spotify\"\n\n    print(json.dumps({\"text\": text, \"class\": \"active paused\", \"tooltip\": tooltip}))\nelse:\n    print(json.dumps({\"text\": \"\\u266b\", \"class\": \"active idle\", \"tooltip\": \"Spotify\"}))'",
    "interval": 2,
    "max-length": 35,
    "tooltip": true,
    "on-click": "playerctl -p spotify play-pause"
  },
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 5
    }
  },
  "custom/apps": {
    "format": "{}",
    "exec": "echo '󰣇'",
    "interval": "once",
    "on-click": "walker",
    "on-click-right": "omarchy-menu power",
    "tooltip": true,
    "tooltip-format": "Apps (L) / Power (R)"
  },
  "custom/btop": {
    "format": "{}",
    "exec": "printf '\\uf489'",
    "interval": "once",
    "on-click": "omarchy-launch-or-focus-tui btop",
    "tooltip": true,
    "tooltip-format": "btop"
  },
  "custom/volume": {
    "format": "{}",
    "exec": "pamixer --get-volume | awk '{if ($1 == 0) print \"󰝟\"; else if ($1 < 30) print \"󰕿\"; else if ($1 < 70) print \"󰖀\"; else print \"󰕾\"}'",
    "interval": 2,
    "on-click": "ghostty -e wiremix",
    "on-click-right": "pamixer -t",
    "on-scroll-up": "pamixer --allow-boost -i 2",
    "on-scroll-down": "pamixer --allow-boost -d 2",
    "tooltip": false
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "󰂲",
    "tooltip-format": "Devices connected: {num_connections}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-no-controller": "No controller detected",
    "on-click": "omarchy-launch-bluetooth"
  },
  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󱘖",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid}",
    "interval": 5,
    "on-click": "omarchy-launch-wifi"
  },
  "custom/battery": {
    "exec": "~/.local/bin/waybar-battery",
    "return-type": "json",
    "interval": 30,
    "on-click": "omarchy-menu power"
  },
  "custom/screensaver": {
    "format": "{}",
    "exec": "if [ -f ~/.local/state/omarchy/toggles/screensaver-off ]; then echo '󰒲'; else echo '󰒳'; fi",
    "interval": 5,
    "on-click": "omarchy-launch-screensaver force",
    "on-click-right": "omarchy-toggle-screensaver",
    "tooltip": true,
    "tooltip-format": "Sleep (L) / Toggle auto (R)"
  }
}
